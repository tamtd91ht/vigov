# ===== ViGov Admin Web — cấu hình môi trường =====
#
# Tệp này là MẪU — chỉ chứa giá trị giữ chỗ, được commit lên git.
#   cp admin-web/.env.example admin-web/.env.local     # rồi điền giá trị thật vào .env.local
#
# `.env.local` là tệp ứng dụng thực sự đọc, KHÔNG BAO GIỜ commit (đã có trong .gitignore).
# Thêm biến mới: khai báo ở CẢ HAI tệp — giá trị thật vào .env.local, giá trị
# giữ chỗ (rỗng hoặc "change-me-...") vào .env.example.

# API backend (NestJS gateway).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Chế độ mock CHỈ dành cho demo giao diện khi chưa dựng backend:
# mật khẩu demo bên dưới nằm trong mã nguồn tải về trình duyệt.
# BẮT BUỘC đặt false ở staging/production — khi đó đăng nhập đi qua
# POST /auth/staff/login và toàn bộ phân quyền do máy chủ quyết định.
#
# MẪU NÀY ĐỂ `false` CÓ CHỦ Ý: tệp .env.example là thứ người ta sao thành
# .env.local trên máy chủ, nên giá trị mặc định phải là giá trị AN TOÀN. Đặt
# `true` ở đây từng là cái bẫy — chỉ cần sao y nguyên là máy chủ thật chạy
# xác thực giả với mật khẩu nằm trong mã nguồn. Muốn trình diễn giao diện khi
# chưa dựng backend thì tự đổi thành `true` trong .env.local của MÁY MÌNH.
NEXT_PUBLIC_USE_MOCKS=false

# Thông tin đơn vị hành chính (đa tenant sau này sẽ lấy từ API)
NEXT_PUBLIC_ORG_NAME=Xã Đại Thắng
NEXT_PUBLIC_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
NEXT_PUBLIC_ORG_SHORT=VG

# Phiên bản hiển thị ở chân sidebar
NEXT_PUBLIC_APP_VERSION=1.0.0-beta

# Tài khoản demo — CHỈ dùng khi NEXT_PUBLIC_USE_MOCKS=true, và để TRỐNG ở mẫu
# này: biến NEXT_PUBLIC_* được nhúng thẳng vào gói JavaScript gửi cho trình
# duyệt, nên điền sẵn ở đây là phát tán mật khẩu demo cho mọi người clone về.
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=

# Dung lượng tối đa mỗi tệp tải lên (byte) — PHẢI khớp STORAGE_MAX_FILE_SIZE
# của backend, nếu không giao diện sẽ báo hợp lệ rồi máy chủ mới từ chối.
NEXT_PUBLIC_MAX_FILE_SIZE=20971520

# Bản đồ kinh tế số — provider sẽ chốt sau (vietmap | goong | maplibre | mock)
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
NEXT_PUBLIC_MAP_API_KEY=
# Bản đồ nền của phân hệ Bản đồ Kinh tế số.
#   mock        → bản mô phỏng bằng CSS, không gọi mạng
#   openfreemap → bản đồ thật, dữ liệu OpenStreetMap, KHÔNG cần khoá API và
#                 không giới hạn lượt xem (hạ tầng do cộng đồng tài trợ)
#   vietmap | goong | ... → nhà cung cấp trong nước, cần khoá API riêng
# Đổi provider thì đổi luôn STYLE_URL; tên miền trong đó tự được mở trong CSP.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Tâm bản đồ lúc mở trang — mỗi đơn vị hành chính một toạ độ
NEXT_PUBLIC_MAP_CENTER_LAT=20.6935
NEXT_PUBLIC_MAP_CENTER_LNG=105.9285
NEXT_PUBLIC_MAP_ZOOM=14


# Kênh thời gian thực (Socket.IO, namespace /realtime của backend).
# false = tắt hẳn việc nối socket; danh sách chỉ tải lại khi người dùng bấm.
NEXT_PUBLIC_REALTIME_ENABLED=true

# Đầu mối hỗ trợ hiển thị ở trang Trợ giúp (mỗi đơn vị một đầu mối khác nhau).
NEXT_PUBLIC_SUPPORT_EMAIL=change-me-support@example.gov.vn
NEXT_PUBLIC_SUPPORT_PHONE=change-me-0000000000
NEXT_PUBLIC_SUPPORT_HOURS=Giờ hành chính, thứ Hai – thứ Sáu (07:30–11:30, 13:30–17:00)
