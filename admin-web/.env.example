# ===== ViGov Admin Web — cấu hình môi trường =====
# Sao chép thành .env.local và điều chỉnh theo môi trường triển khai.

# API backend (NestJS gateway).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Chế độ mock CHỈ dành cho demo giao diện khi chưa dựng backend:
# mật khẩu demo bên dưới nằm trong mã nguồn tải về trình duyệt.
# BẮT BUỘC đặt false ở staging/production — khi đó đăng nhập đi qua
# POST /auth/staff/login và toàn bộ phân quyền do máy chủ quyết định.
NEXT_PUBLIC_USE_MOCKS=true

# Thông tin đơn vị hành chính (đa tenant sau này sẽ lấy từ API)
NEXT_PUBLIC_ORG_NAME=Xã Đại Thắng
NEXT_PUBLIC_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
NEXT_PUBLIC_ORG_SHORT=VG

# Phiên bản hiển thị ở chân sidebar
NEXT_PUBLIC_APP_VERSION=1.0.0-beta

# Tài khoản demo — CHỈ dùng khi NEXT_PUBLIC_USE_MOCKS=true.
# Để trống ở staging/production.
NEXT_PUBLIC_DEMO_USERNAME=admin
NEXT_PUBLIC_DEMO_PASSWORD=123456

# Dung lượng tối đa mỗi tệp tải lên (byte) — PHẢI khớp STORAGE_MAX_FILE_SIZE
# của backend, nếu không giao diện sẽ báo hợp lệ rồi máy chủ mới từ chối.
NEXT_PUBLIC_MAX_FILE_SIZE=20971520

# Bản đồ kinh tế số — provider sẽ chốt sau (vietmap | goong | maplibre | mock)
NEXT_PUBLIC_MAP_PROVIDER=mock
NEXT_PUBLIC_MAP_API_KEY=
