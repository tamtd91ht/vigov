# ===== ViGov Zalo Mini App — cấu hình môi trường =====
#
# Tệp này là MẪU — chỉ chứa giá trị giữ chỗ, được commit lên git.
#   cp zalo-miniapp/.env.example zalo-miniapp/.env.local     # rồi điền giá trị thật vào .env.local
#
# `.env.local` là tệp ứng dụng thực sự đọc, KHÔNG BAO GIỜ commit (đã có trong .gitignore).
# Thêm biến mới: khai báo ở CẢ HAI tệp — giá trị thật vào .env.local, giá trị
# giữ chỗ (rỗng hoặc "change-me-...") vào .env.example.
VITE_API_BASE_URL=http://localhost:3001/api/v1
# true = chạy bằng dữ liệu mẫu trong src/mocks (trình diễn offline, không cần backend)
VITE_USE_MOCKS=false

VITE_ORG_NAME=Xã Đại Thắng
VITE_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
VITE_ORG_SHORT=VG

# Điền sau khi khách đăng ký Zalo OA/Business (câu hỏi mở #3)
VITE_ZALO_APP_ID=
VITE_ZALO_OA_ID=

VITE_HOTLINE=024 3378 2200
VITE_APP_VERSION=1.0.0-beta
