# ===== ViGov Zalo Mini App — cấu hình môi trường =====
#
# Tệp này là MẪU — chỉ chứa giá trị giữ chỗ, được commit lên git.
#   cp zalo-miniapp/.env.example zalo-miniapp/.env.local     # rồi điền giá trị thật vào .env.local
#
# `.env.local` là tệp ứng dụng thực sự đọc, KHÔNG BAO GIỜ commit (đã có trong .gitignore).
# Thêm biến mới: khai báo ở CẢ HAI tệp — giá trị thật vào .env.local, giá trị
# giữ chỗ (rỗng hoặc "change-me-...") vào .env.example.
VITE_API_BASE_URL=http://localhost:3001/api/v1
# true = chạy bằng dữ liệu mẫu trong src/mocks (trình diễn offline, không cần backend)
VITE_USE_MOCKS=false
# true = zaloService tra du lieu mau thay vi goi zmp-sdk (camera, vi tri, so dien thoai).
# TACH RIENG khoi VITE_USE_MOCKS: cai kia la du lieu nghiep vu tu backend, cai nay la
# API thiet bi cua Zalo. Ban chay trong Zalo PHAI de false, neu khong nut quet chi quay
# mot nhip roi tra chuoi mau ma khong mo camera.
VITE_USE_MOCK_SDK=false

# true = BẢN DEMO: app hiện pop-up cảnh báo khi mở, gắn nhãn "Demo" ở các màn mô
# phỏng, tên app thành "ViGov Demo". Mặc định trong mã nguồn cũng là true.
# Bản đang nộp xét duyệt Zalo là bản demo (hồ sơ bị từ chối 05/09/2026 vì app mô
# phỏng thông tin cơ quan nhà nước mà không nói rõ là demo).
# Chuyển sang bản chính thức: đặt false VÀ trỏ VITE_ORG_* về tên đơn vị thật.
VITE_DEMO_MODE=true

# Bản demo KHÔNG được mượn tên địa danh có thật — đó là điều Zalo nêu khi từ chối
# hồ sơ. Bản chính thức mới điền tên đơn vị thật (kèm VITE_DEMO_MODE=false).
VITE_ORG_NAME=Xã Demo
VITE_ORG_PARENT=Huyện Demo · Tỉnh Demo
VITE_ORG_SHORT=VG

# Điền sau khi khách đăng ký Zalo OA/Business (câu hỏi mở #3)
VITE_ZALO_APP_ID=
VITE_ZALO_OA_ID=

VITE_HOTLINE=024 3378 2200
# Bản đồ kinh tế số trong Mini App: mock | openfreemap | vietmap | goong …
#   mock        → bản mô phỏng bằng CSS, KHÔNG gọi mạng
#   openfreemap → bản đồ thật, dữ liệu OpenStreetMap, không cần khoá API
# LƯU Ý: Mini App chạy trong webview của Zalo — tên miền tile phải được khai
# trong danh sách domain của ứng dụng trên Zalo Developers, nếu không tile im
# lặng không tải được.
VITE_MAP_PROVIDER=openfreemap
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_CENTER_LAT=20.6935
VITE_MAP_CENTER_LNG=105.9285
VITE_MAP_ZOOM=14

VITE_APP_VERSION=1.0.0-beta
