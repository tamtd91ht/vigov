{
  "name": "zalo-miniapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "zmp:login": "zmp login",
    "zmp:deploy": "npm run build && npm run zmp:prepare && zmp deploy -e -o dist",
    "zmp:deploy:test": "npm run build && npm run zmp:prepare && zmp deploy -e -o dist -t",
    "zmp:start": "zmp start",
    "zmp:prepare": "node scripts/zmp-prepare.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zmp-sdk": "^2.53.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "zmp-cli": "^4.0.3"
  }
}
