{
  "name": "vigov-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ViGov — Backend micro-services (NestJS monorepo)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start api-gateway --watch",
    "start:dev": "nest start api-gateway --watch",
    "start:prod": "node dist/apps/api-gateway/apps/api-gateway/src/main",
    "seed": "ts-node -r tsconfig-paths/register apps/api-gateway/src/seed.ts",
    "seed:demo": "ts-node -r tsconfig-paths/register apps/api-gateway/src/seed.ts",
    "seed:fresh": "ts-node -r tsconfig-paths/register apps/api-gateway/src/seed.ts --fresh",
    "seed:prod": "node dist/apps/api-gateway/apps/api-gateway/src/seed",
    "lint": "eslint \"{apps,libs}/**/*.ts\"",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc --noEmit -p apps/api-gateway/tsconfig.app.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.2.3",
    "amqp-connection-manager": "^4.1.14",
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "mongoose": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  }
}
