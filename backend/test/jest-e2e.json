{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "globalSetup": "<rootDir>/support/e2e-tmpdir.js",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@vigov/shared(|/.*)$": "<rootDir>/../libs/shared/src$1"
  },
  "testTimeout": 180000
}
