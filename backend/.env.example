# ===== ViGov Backend — cấu hình môi trường =====
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# MongoDB
MONGO_URI=mongodb://localhost:27017/vigov

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_NOTIFICATION_QUEUE=vigov.notification
RABBITMQ_WORKFLOW_QUEUE=vigov.workflow

# Auth
# !!! BẮT BUỘC đổi JWT_SECRET trước khi lên production !!!
# Khoá này vừa ký token đăng nhập vừa ký link tải tệp riêng tư — lộ khoá là lộ toàn bộ hệ thống.
# Sinh khoá ngẫu nhiên tối thiểu 32 ký tự, ví dụ: openssl rand -base64 48
# Khi NODE_ENV=production mà vẫn để giá trị mẫu này, API Gateway sẽ TỪ CHỐI khởi động.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN=7d

# Rate limit / chống spam (P3-31)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
FEEDBACK_MAX_PER_DAY=5

# ===== Bảo mật tầng HTTP (P4-36) =====
# Whitelist CORS: liệt kê tên miền được phép gọi API, phân tách bằng dấu phẩy.
# Dev có thể để '*'. Ở production BẮT BUỘC khai báo tên miền thật,
# ví dụ: CORS_ORIGINS=https://quantri.xadaithang.gov.vn,https://h5.zdn.vn
CORS_ORIGINS=*

# Giới hạn kích thước thân yêu cầu JSON / form (tệp tải lên dùng STORAGE_MAX_FILE_SIZE)
BODY_LIMIT=1mb

# Hiệu lực Strict-Transport-Security (giây) — chỉ gắn khi NODE_ENV=production và đã có HTTPS
HSTS_MAX_AGE=31536000

# Cấu hình 'trust proxy' của Express khi chạy sau nginx/load balancer.
# Bỏ trống = không tin proxy. Đặt '1' khi có đúng một lớp nginx phía trước,
# nếu không rate-limit và nhật ký sẽ ghi nhầm IP của proxy cho mọi người dùng.
TRUST_PROXY=

# File storage (P3-24): local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Dung lượng tối đa mỗi tệp tải lên (byte) — mặc định 20MB
STORAGE_MAX_FILE_SIZE=20971520

# OCR provider (P3-25) — chốt sau (câu hỏi mở #1)
OCR_PROVIDER=mock
OCR_API_KEY=

# GIS/Geocoding (P3-26) — chốt sau (câu hỏi mở #2)
GEO_PROVIDER=mock
GEO_API_KEY=

# Zalo (P3-23)
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZNS_TEMPLATE_FEEDBACK_RECEIVED=
ZNS_TEMPLATE_FEEDBACK_RESOLVED=
