<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 trở lên CHẶN HTTP thường theo mặc định. Backend giai đoạn phát triển
  chạy http://localhost:3001 nên phải mở ngoại lệ, nhưng chỉ cho các địa chỉ nội bộ:
  Internet công cộng vẫn bắt buộc HTTPS.

  Chạy trên THIẾT BỊ THẬT cùng mạng LAN: thêm IP máy phát triển vào danh sách bên dưới,
  ví dụ <domain includeSubdomains="false">192.168.1.12</domain>.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator Android trỏ về máy phát triển qua 10.0.2.2 -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- Emulator Genymotion -->
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Máy phát triển trên mạng Wi-Fi nội bộ — đổi theo IP thật khi chuyển máy -->
        <domain includeSubdomains="false">192.168.1.32</domain>
    </domain-config>
</network-security-config>
