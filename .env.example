# =============================================================================
# ViGov — biến môi trường cho docker-compose.yml ở thư mục gốc (P4-34 / WBS #34–35)
#
# CÁCH DÙNG
#   cp .env.example .env      # rồi sửa toàn bộ giá trị "change-me-..."
#   chmod 600 .env            # chỉ user triển khai đọc được
#   docker compose config     # kiểm tra cú pháp trước khi chạy
#   docker compose up -d
#
# NGOẠI LỆ CÓ CHỦ Ý — vì sao ở đây là `.env` chứ không phải `.env.local`:
#   Docker Compose chỉ tự đọc đúng tệp tên `.env` cùng thư mục; nó KHÔNG biết
#   tới `.env.local`. Quên `--env-file` là mọi biến thành rỗng mà không báo lỗi.
#   Nên quy ước của dự án là:
#     · thư mục gốc      → `.env`        (docker-compose khi triển khai)
#     · backend/         → `.env.local`  (ứng dụng đọc khi chạy dev)
#     · admin-web/       → `.env.local`
#     · zalo-miniapp/    → `.env.local`
#   Cả hai đều nằm trong .gitignore; chỉ `.env.example` được commit.
#
# QUY TẮC BẮT BUỘC
#   · File `.env` chứa secret thật — KHÔNG commit vào git, KHÔNG gửi qua chat.
#     Trên máy chủ: `chmod 600 .env` và chỉ user triển khai đọc được.
#   · Chỉ file này (.env.example) được commit, và chỉ chứa giá trị mẫu.
#   · Staging và production dùng 2 file .env khác nhau, secret khác nhau.
# =============================================================================

# ─── Chung ───────────────────────────────────────────────────────────────────
# Tiền tố tên container/volume/network. Đổi thành vigov-staging trên máy staging.
COMPOSE_PROJECT_NAME=vigov

# Registry chứa image đã build sẵn (CI push lên). Để TRỐNG nếu build tại chỗ
# bằng `docker compose build`. Nhớ dấu "/" cuối, ví dụ: registry.example.vn/vigov/
IMAGE_REGISTRY=
# Tag image — CI đặt theo <branch>-<git-short-sha>; máy dev để "local".
IMAGE_TAG=local

# Múi giờ container (log, cron backup, tính hạn SLA hiển thị).
TZ=Asia/Ho_Chi_Minh

# ─── Cổng publish ra host ────────────────────────────────────────────────────
# MẶC ĐỊNH CHỈ MỞ TRÊN 127.0.0.1: reverse proxy (nginx/HAProxy) trên chính máy
# chủ mới là thứ lộ ra Internet kèm TLS. Chỉ đổi sang 0.0.0.0 khi thật sự cần.
PUBLIC_BIND_IP=127.0.0.1
BACKEND_PORT=3001
ADMIN_WEB_PORT=3000
ZALO_MINIAPP_PORT=8085

# Hạ tầng nội bộ — KHÔNG BAO GIỜ mở ra ngoài 127.0.0.1 ở production.
INFRA_BIND_IP=127.0.0.1
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_IMAGE=mongo:7
# Cache WiredTiger (GB). Khi Mongo chạy chung máy với backend + admin-web,
# để mặc định là Mongo ăn ~50% (RAM - 1GB) rồi Node bị OOM killer bắn.
# Đặt khoảng 1/4 RAM máy chủ: máy 8GB → 2, máy 16GB → 4.
MONGO_CACHE_GB=2
MONGO_ROOT_USERNAME=vigov_root
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DATABASE=vigov
# Chuỗi kết nối backend dùng. Host là tên service `mongo` trong mạng nội bộ.
# Phải khớp username/password/database ở trên; authSource=admin vì tài khoản
# root do biến MONGO_INITDB_ROOT_* tạo nằm ở database `admin`.
MONGO_URI=mongodb://vigov_root:change-me-strong-password@mongo:27017/vigov?authSource=admin

# Thư mục trên host để mongodump ghi bản sao lưu (xem deploy/README.md).
BACKUP_DIR=./backups

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_IMAGE=rabbitmq:3.13-management
RABBITMQ_DEFAULT_USER=vigov
RABBITMQ_DEFAULT_PASS=change-me-strong-password
RABBITMQ_URI=amqp://vigov:change-me-strong-password@rabbitmq:5672
RABBITMQ_NOTIFICATION_QUEUE=vigov.notification
RABBITMQ_WORKFLOW_QUEUE=vigov.workflow

# ─── Backend (NestJS api-gateway) ────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api/v1

# Auth — JWT_SECRET phải là chuỗi ngẫu nhiên ≥ 32 ký tự, MỖI MÔI TRƯỜNG MỘT KHOÁ.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN=7d

# ─── Lối vào tạm cho giai đoạn thử nghiệm ────────────────────────────────────
# Cho phép nhập một mã cố định ở màn OTP để định danh, dùng khi Zalo chưa cấp
# quyền getPhoneNumber và mã OTP thật còn chưa gửi được qua SMS/ZNS.
#
#   · ĐỂ TRỐNG là TẮT HẲN — mặc định, và là trạng thái đúng khi chạy thật.
#   · Phải là ĐÚNG 6 CHỮ SỐ: ô nhập OTP của Mini App cố định 6 ký tự và lọc bỏ
#     mọi ký tự không phải số, nên mã dài hơn hoặc có chữ sẽ không gõ vào được.
#   · Mã này định danh được MỌI số điện thoại. Mỗi lần dùng ghi warn kèm số và
#     IP; backend cũng cảnh báo mỗi lần khởi động khi biến còn giá trị.
#   · Chặn dò mã là hạn mức 5 lượt/phút mỗi IP (AUTH_THROTTLE), không phải độ
#     dài — nên đừng nới hạn mức đó chừng nào biến này còn bật.
CITIZEN_OTP_BYPASS_CODE=
# Nơi lưu mã OTP định danh công dân: memory | mongo
# `memory` (mặc định) đủ khi chạy MỘT instance. Chạy nhiều instance sau bộ cân
# bằng tải thì BẮT BUỘC đặt `mongo`: mã sinh ở instance A không xác thực được ở
# instance B, và bộ đếm số lần nhập sai cũng không dùng chung — xem SECURITY.md TB-08.
OTP_STORE=memory


# Rate limit / chống spam (P3-31)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
FEEDBACK_MAX_PER_DAY=5

# Lưu tệp (P3-24): local (volume `uploads`) | s3 (MinIO hoặc S3 tương thích)
STORAGE_DRIVER=local
# 20 MiB
STORAGE_MAX_FILE_SIZE=20971520
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OCR provider (P3-25) — chốt sau (câu hỏi mở #1)
# LƯU Ý: cấu hình ở Web Quản trị → Cấu hình → Tích hợp THẮNG các biến dưới đây.
#        Ba biến này là giá trị mồi khi chưa ai cấu hình ở giao diện.
#   mock     — dữ liệu giả lập, mặc định
#   ocrspace — dịch vụ MIỄN PHÍ ocr.space. Bản scan bị gửi ra máy chủ nước
#              ngoài, nên KHÔNG dùng với văn bản thật của công dân — chưa có cơ
#              sở pháp lý theo NĐ 13/2023. Chọn provider này là mỗi lần cán bộ
#              quét, giao diện hiện cảnh báo và backend ghi một dòng warn.
#              Người quản trị chịu trách nhiệm với dữ liệu đưa vào.
#              Lấy khoá miễn phí tại https://ocr.space/ocrapi (25.000 lượt/tháng,
#              tệp tối đa 1MB).
OCR_PROVIDER=mock
OCR_API_KEY=
# Để trống thì dùng điểm cuối mặc định của provider. Chỉ đặt khi tự dựng máy chủ OCR.
OCR_ENDPOINT=

# Đọc thẻ căn cước (P5-11) — tầng 3 (OCR), chốt sau cùng câu hỏi mở #1.
# Đường chính là quét QR/NFC ngay trên máy người dùng, không qua backend.
# Trước khi đổi khỏi "mock": phải có hợp đồng xử lý dữ liệu cá nhân (NĐ 13/2023).
IDCARD_PROVIDER=mock
IDCARD_API_KEY=

# GIS/Geocoding (P3-26) — provider chốt sau (câu hỏi mở #2)
GEO_PROVIDER=mock
GEO_API_KEY=

# Zalo OA / ZNS (P3-23) — điền sau khi khách đăng ký OA (câu hỏi mở #3)
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
# Access token của Zalo OA — do luồng OAuth của Zalo cấp, hạn 1 giờ, gia hạn bằng
# refresh token (hạn 3 tháng). KHÔNG phải ZALO_APP_SECRET. Chưa có token này thì
# provider ZNS báo thất bại thay vì im lặng bỏ qua tin nhắn.
ZALO_OA_ACCESS_TOKEN=
ZNS_TEMPLATE_FEEDBACK_RECEIVED=
ZNS_TEMPLATE_FEEDBACK_RESOLVED=

# Push mobile (Firebase Cloud Messaging)
PUSH_PROVIDER=mock
FCM_SERVER_KEY=

# Mật khẩu khởi tạo cho tài khoản cán bộ khi chạy `npm run seed`.
# BẮT BUỘC đổi trước khi seed production và ép cán bộ đổi ở lần đăng nhập đầu.
SEED_DEFAULT_PASSWORD=change-me-first-login-password

# ─── Bảo mật tầng HTTP (P4-36) — BẮT BUỘC điền trước khi chạy production ─────
# Whitelist CORS: liệt kê ĐẦY ĐỦ origin được phép gọi API, phân tách bằng dấu phẩy.
# Ở production backend TỪ CHỐI KHỞI ĐỘNG nếu để trống hoặc để "*".
#   · Web Quản trị:  https://admin-vigov.omicrm.com
#   · Zalo Mini App: https://h5.zdn.vn   (mọi Mini App chạy trong webview này)
#   · App Flutter KHÔNG cần khai (ứng dụng gốc không gửi header Origin)
CORS_ORIGINS=https://admin-vigov.omicrm.com,https://miniapp-vigov.omicrm.com,https://h5.zdn.vn

# Giới hạn kích thước thân yêu cầu JSON/form (tệp tải lên dùng STORAGE_MAX_FILE_SIZE)
BODY_LIMIT=1mb

# Hiệu lực Strict-Transport-Security (giây) — chỉ gắn khi NODE_ENV=production
HSTS_MAX_AGE=31536000

# Số lớp reverse proxy đứng trước backend. Có đúng một nginx thì đặt 1;
# để trống thì rate-limit và nhật ký sẽ ghi nhầm IP của proxy cho mọi người dùng.
TRUST_PROXY=1

# Tài khoản quản trị rút gọn tạo khi seed. Production PHẢI đặt mật khẩu mạnh.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# ─── Web Quản trị (Next.js) — NHÚNG LÚC BUILD ────────────────────────────────
# CẢNH BÁO: các biến NEXT_PUBLIC_* dưới đây được ghi thẳng vào bundle JS khi
# `docker compose build admin-web`. Sửa xong PHẢI build lại image, đổi env rồi
# `up` lại là KHÔNG có tác dụng. Cũng vì thế: tuyệt đối không đặt secret ở đây.
# URL này do TRÌNH DUYỆT của cán bộ gọi ⇒ phải là domain public, không phải
# tên service nội bộ `backend`.
# ĐỂ TƯƠNG ĐỐI: trình duyệt gọi API qua chính tên miền admin, Next chuyển
# tiếp sang backend ở phía máy chủ (next.config.ts). Nhờ vậy Web Quản trị
# không đụng CORS — gateway .151 dùng chung thiếu PATCH trong danh sách
# Access-Control-Allow-Methods, mà ta không được sửa cấu hình máy đó.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Đích chuyển tiếp phía máy chủ; tên service trong mạng Docker nội bộ.
# Next nạp lúc BUILD nên đổi xong phải build lại image admin-web.
API_PROXY_TARGET=http://backend:3001
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ORG_NAME=Xã Đại Thắng
NEXT_PUBLIC_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
NEXT_PUBLIC_ORG_SHORT=VG
NEXT_PUBLIC_APP_VERSION=1.0.0
# Để trống ở production (chỉ phục vụ chế độ mock)
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=
NEXT_PUBLIC_MAP_PROVIDER=openfreemap
NEXT_PUBLIC_MAP_API_KEY=
# Bản đồ nền của phân hệ Bản đồ Kinh tế số.
#   mock        → bản mô phỏng bằng CSS, không gọi mạng
#   openfreemap → bản đồ thật, dữ liệu OpenStreetMap, KHÔNG cần khoá API và
#                 không giới hạn lượt xem (hạ tầng do cộng đồng tài trợ)
#   vietmap | goong | ... → nhà cung cấp trong nước, cần khoá API riêng
# Đổi provider thì đổi luôn STYLE_URL; tên miền trong đó tự được mở trong CSP.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Tâm bản đồ lúc mở trang — mỗi đơn vị hành chính một toạ độ
NEXT_PUBLIC_MAP_CENTER_LAT=20.6935
NEXT_PUBLIC_MAP_CENTER_LNG=105.9285
NEXT_PUBLIC_MAP_ZOOM=14

# Kênh thời gian thực. Chỉ hoạt động khi reverse proxy chuyển tiếp `/socket.io/`
# kèm nâng cấp WebSocket (xem deploy/nginx-vigov.conf) — chưa cấu hình thì đặt false.
NEXT_PUBLIC_REALTIME_ENABLED=true
# Đầu mối hỗ trợ hiển thị ở trang Trợ giúp của Web Quản trị
NEXT_PUBLIC_SUPPORT_EMAIL=change-me-support@example.gov.vn
NEXT_PUBLIC_SUPPORT_PHONE=change-me-0000000000
NEXT_PUBLIC_SUPPORT_HOURS=Giờ hành chính, thứ Hai – thứ Sáu (07:30–11:30, 13:30–17:00)

# Dung lượng tối đa mỗi tệp tải lên từ Web Quản trị (byte).
# PHẢI khớp STORAGE_MAX_FILE_SIZE. Nhúng vào bundle lúc BUILD.
NEXT_PUBLIC_MAX_FILE_SIZE=20971520

# ─── Zalo Mini App (Vite) — NHÚNG LÚC BUILD ──────────────────────────────────
# Cùng cảnh báo như trên: đổi giá trị ⇒ phải build lại image zalo-miniapp.
VITE_API_BASE_URL=https://api-vigov.omicrm.com/api/v1
VITE_USE_MOCKS=false
# true = bản demo: pop-up cảnh báo khi mở app + nhãn "Demo" ở các màn mô phỏng.
# Bản đang nộp xét duyệt Zalo là bản demo. Bản chính thức: false + tên đơn vị thật.
VITE_DEMO_MODE=true
VITE_ORG_NAME=Xã Demo
VITE_ORG_PARENT=Huyện Demo · Tỉnh Demo
VITE_ORG_SHORT=VG
# ID MINI APP (không phải ZALO_APP_ID ở trên — hai số khác nhau):
#   ZALO_APP_ID       = ứng dụng Zalo, dùng cho webhook/OA phía backend
#   VITE_ZALO_APP_ID  = Mini App, thứ zmp-sdk cần khi chạy trong Zalo
VITE_ZALO_APP_ID=
# Cờ mock API THIẾT BỊ của Zalo (camera, vị trí, SĐT) — tách khỏi
# VITE_USE_MOCKS (dữ liệu nghiệp vụ). Bản chạy trong Zalo PHẢI để false.
VITE_USE_MOCK_SDK=false
VITE_ZALO_OA_ID=
VITE_HOTLINE=024 3378 2200
# Bản đồ kinh tế số trong Mini App: mock | openfreemap | vietmap | goong …
#   mock        → bản mô phỏng bằng CSS, KHÔNG gọi mạng
#   openfreemap → bản đồ thật, dữ liệu OpenStreetMap, không cần khoá API
# LƯU Ý: Mini App chạy trong webview của Zalo — tên miền tile phải được khai
# trong danh sách domain của ứng dụng trên Zalo Developers, nếu không tile im
# lặng không tải được.
VITE_MAP_PROVIDER=openfreemap
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
VITE_MAP_CENTER_LAT=20.6935
VITE_MAP_CENTER_LNG=105.9285
VITE_MAP_ZOOM=14

# Dung lượng tối đa mỗi ảnh hiện trường công dân tải lên (byte).
# PHẢI khớp STORAGE_MAX_FILE_SIZE ở trên — lệch thì người dân chờ tải hết ảnh
# rồi mới nhận lỗi 413 từ máy chủ. Nhúng vào bundle lúc BUILD Mini App.
VITE_MAX_FILE_SIZE=20971520

VITE_APP_VERSION=1.0.0
