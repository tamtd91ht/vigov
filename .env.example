# =============================================================================
# ViGov — biến môi trường cho docker-compose.yml ở thư mục gốc (P4-34 / WBS #34–35)
#
# CÁCH DÙNG
#   cp .env.example .env      # rồi sửa toàn bộ giá trị "change-me-..."
#   chmod 600 .env            # chỉ user triển khai đọc được
#   docker compose config     # kiểm tra cú pháp trước khi chạy
#   docker compose up -d
#
# NGOẠI LỆ CÓ CHỦ Ý — vì sao ở đây là `.env` chứ không phải `.env.local`:
#   Docker Compose chỉ tự đọc đúng tệp tên `.env` cùng thư mục; nó KHÔNG biết
#   tới `.env.local`. Quên `--env-file` là mọi biến thành rỗng mà không báo lỗi.
#   Nên quy ước của dự án là:
#     · thư mục gốc      → `.env`        (docker-compose khi triển khai)
#     · backend/         → `.env.local`  (ứng dụng đọc khi chạy dev)
#     · admin-web/       → `.env.local`
#     · zalo-miniapp/    → `.env.local`
#   Cả hai đều nằm trong .gitignore; chỉ `.env.example` được commit.
#
# QUY TẮC BẮT BUỘC
#   · File `.env` chứa secret thật — KHÔNG commit vào git, KHÔNG gửi qua chat.
#     Trên máy chủ: `chmod 600 .env` và chỉ user triển khai đọc được.
#   · Chỉ file này (.env.example) được commit, và chỉ chứa giá trị mẫu.
#   · Staging và production dùng 2 file .env khác nhau, secret khác nhau.
# =============================================================================

# ─── Chung ───────────────────────────────────────────────────────────────────
# Tiền tố tên container/volume/network. Đổi thành vigov-staging trên máy staging.
COMPOSE_PROJECT_NAME=vigov

# Registry chứa image đã build sẵn (CI push lên). Để TRỐNG nếu build tại chỗ
# bằng `docker compose build`. Nhớ dấu "/" cuối, ví dụ: registry.example.vn/vigov/
IMAGE_REGISTRY=
# Tag image — CI đặt theo <branch>-<git-short-sha>; máy dev để "local".
IMAGE_TAG=local

# Múi giờ container (log, cron backup, tính hạn SLA hiển thị).
TZ=Asia/Ho_Chi_Minh

# ─── Cổng publish ra host ────────────────────────────────────────────────────
# MẶC ĐỊNH CHỈ MỞ TRÊN 127.0.0.1: reverse proxy (nginx/HAProxy) trên chính máy
# chủ mới là thứ lộ ra Internet kèm TLS. Chỉ đổi sang 0.0.0.0 khi thật sự cần.
PUBLIC_BIND_IP=127.0.0.1
BACKEND_PORT=3001
ADMIN_WEB_PORT=3000
ZALO_MINIAPP_PORT=8080

# Hạ tầng nội bộ — KHÔNG BAO GIỜ mở ra ngoài 127.0.0.1 ở production.
INFRA_BIND_IP=127.0.0.1
MONGO_PORT=27017
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_IMAGE=mongo:7
# Cache WiredTiger (GB). Khi Mongo chạy chung máy với backend + admin-web,
# để mặc định là Mongo ăn ~50% (RAM - 1GB) rồi Node bị OOM killer bắn.
# Đặt khoảng 1/4 RAM máy chủ: máy 8GB → 2, máy 16GB → 4.
MONGO_CACHE_GB=2
MONGO_ROOT_USERNAME=vigov_root
MONGO_ROOT_PASSWORD=change-me-strong-password
MONGO_DATABASE=vigov
# Chuỗi kết nối backend dùng. Host là tên service `mongo` trong mạng nội bộ.
# Phải khớp username/password/database ở trên; authSource=admin vì tài khoản
# root do biến MONGO_INITDB_ROOT_* tạo nằm ở database `admin`.
MONGO_URI=mongodb://vigov_root:change-me-strong-password@mongo:27017/vigov?authSource=admin

# Thư mục trên host để mongodump ghi bản sao lưu (xem deploy/README.md).
BACKUP_DIR=./backups

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_IMAGE=rabbitmq:3.13-management
RABBITMQ_DEFAULT_USER=vigov
RABBITMQ_DEFAULT_PASS=change-me-strong-password
RABBITMQ_URI=amqp://vigov:change-me-strong-password@rabbitmq:5672
RABBITMQ_NOTIFICATION_QUEUE=vigov.notification
RABBITMQ_WORKFLOW_QUEUE=vigov.workflow

# ─── Backend (NestJS api-gateway) ────────────────────────────────────────────
NODE_ENV=production
API_PREFIX=api/v1

# Auth — JWT_SECRET phải là chuỗi ngẫu nhiên ≥ 32 ký tự, MỖI MÔI TRƯỜNG MỘT KHOÁ.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN=7d

# Rate limit / chống spam (P3-31)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
FEEDBACK_MAX_PER_DAY=5

# Lưu tệp (P3-24): local (volume `uploads`) | s3 (MinIO hoặc S3 tương thích)
STORAGE_DRIVER=local
# 20 MiB
STORAGE_MAX_FILE_SIZE=20971520
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OCR (P3-25) — provider chốt sau (câu hỏi mở #1)
OCR_PROVIDER=mock
OCR_API_KEY=

# Đọc thẻ căn cước (P5-11) — tầng 3 (OCR), chốt sau cùng câu hỏi mở #1.
# Đường chính là quét QR/NFC ngay trên máy người dùng, không qua backend.
# Trước khi đổi khỏi "mock": phải có hợp đồng xử lý dữ liệu cá nhân (NĐ 13/2023).
IDCARD_PROVIDER=mock
IDCARD_API_KEY=

# GIS/Geocoding (P3-26) — provider chốt sau (câu hỏi mở #2)
GEO_PROVIDER=mock
GEO_API_KEY=

# Zalo OA / ZNS (P3-23) — điền sau khi khách đăng ký OA (câu hỏi mở #3)
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZNS_TEMPLATE_FEEDBACK_RECEIVED=
ZNS_TEMPLATE_FEEDBACK_RESOLVED=

# Push mobile (Firebase Cloud Messaging)
PUSH_PROVIDER=mock
FCM_SERVER_KEY=

# Mật khẩu khởi tạo cho tài khoản cán bộ khi chạy `npm run seed`.
# BẮT BUỘC đổi trước khi seed production và ép cán bộ đổi ở lần đăng nhập đầu.
SEED_DEFAULT_PASSWORD=change-me-first-login-password

# ─── Bảo mật tầng HTTP (P4-36) — BẮT BUỘC điền trước khi chạy production ─────
# Whitelist CORS: liệt kê ĐẦY ĐỦ origin được phép gọi API, phân tách bằng dấu phẩy.
# Ở production backend TỪ CHỐI KHỞI ĐỘNG nếu để trống hoặc để "*".
#   · Web Quản trị:  https://quantri.vigov.<tên-miền>
#   · Zalo Mini App: https://h5.zdn.vn   (mọi Mini App chạy trong webview này)
#   · App Flutter KHÔNG cần khai (ứng dụng gốc không gửi header Origin)
CORS_ORIGINS=https://quantri.vigov.local,https://h5.zdn.vn

# Giới hạn kích thước thân yêu cầu JSON/form (tệp tải lên dùng STORAGE_MAX_FILE_SIZE)
BODY_LIMIT=1mb

# Hiệu lực Strict-Transport-Security (giây) — chỉ gắn khi NODE_ENV=production
HSTS_MAX_AGE=31536000

# Số lớp reverse proxy đứng trước backend. Có đúng một nginx thì đặt 1;
# để trống thì rate-limit và nhật ký sẽ ghi nhầm IP của proxy cho mọi người dùng.
TRUST_PROXY=1

# Tài khoản quản trị rút gọn tạo khi seed. Production PHẢI đặt mật khẩu mạnh.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-admin-password

# ─── Web Quản trị (Next.js) — NHÚNG LÚC BUILD ────────────────────────────────
# CẢNH BÁO: các biến NEXT_PUBLIC_* dưới đây được ghi thẳng vào bundle JS khi
# `docker compose build admin-web`. Sửa xong PHẢI build lại image, đổi env rồi
# `up` lại là KHÔNG có tác dụng. Cũng vì thế: tuyệt đối không đặt secret ở đây.
# URL này do TRÌNH DUYỆT của cán bộ gọi ⇒ phải là domain public, không phải
# tên service nội bộ `backend`.
NEXT_PUBLIC_API_BASE_URL=https://api.vigov.local/api/v1
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ORG_NAME=Xã Đại Thắng
NEXT_PUBLIC_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
NEXT_PUBLIC_ORG_SHORT=VG
NEXT_PUBLIC_APP_VERSION=1.0.0
# Để trống ở production (chỉ phục vụ chế độ mock)
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=
NEXT_PUBLIC_MAP_PROVIDER=mock
NEXT_PUBLIC_MAP_API_KEY=

# ─── Zalo Mini App (Vite) — NHÚNG LÚC BUILD ──────────────────────────────────
# Cùng cảnh báo như trên: đổi giá trị ⇒ phải build lại image zalo-miniapp.
VITE_API_BASE_URL=https://api.vigov.local/api/v1
VITE_USE_MOCKS=false
VITE_ORG_NAME=Xã Đại Thắng
VITE_ORG_PARENT=Huyện Phú Xuyên · Thành phố Hà Nội
VITE_ORG_SHORT=VG
VITE_ZALO_APP_ID=
VITE_ZALO_OA_ID=
VITE_HOTLINE=024 3378 2200
VITE_APP_VERSION=1.0.0
